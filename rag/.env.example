# Copy this file to  .env  and fill in the values you need. NEVER commit .env.

# Choose ONE provider: huggingface | ollama | openai | gemini
LLM_PROVIDER=huggingface

# Optional: override the default model of the chosen provider
# Hugging Face model id (default for huggingface). For Ollama use e.g. qwen2.5:7b
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# Smaller options if memory is short:  Qwen/Qwen2.5-3B-Instruct  |  Qwen/Qwen2.5-1.5B-Instruct
# LLM_TEMPERATURE=0

# Only the key for the provider you chose is needed
OPENAI_API_KEY=
GEMINI_API_KEY=

# Hugging Face local settings
# HF_DEVICE=auto          (auto | cpu | cuda)
# HF_MAX_NEW_TOKENS=400
# HF_HUB_OFFLINE=1        (after the first download: never contact the Hub)

# Ollama (local, no key). Default shown:
# OLLAMA_URL=http://localhost:11434
# OLLAMA_NUM_CTX=4096

# ---- Embedding model (any Sentence Transformers model from Hugging Face) ----
# After changing it you MUST re-run ingest.py (see the switching steps).
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Chunking and retrieval ----
# CHUNK_SIZE_TOKENS=300
# CHUNK_OVERLAP_TOKENS=40
# TOP_K=5
