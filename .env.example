# Copy to .env and adjust. Both the backend and the frontend read these from the environment.

# ---- backend -------------------------------------------------------------------------
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0                 # 1 enables the Werkzeug debugger. Never in production.
LOG_LEVEL=INFO
LOG_JSON=1                    # 0 = human-readable logs
MODEL_DIR=models              # folder containing model_manifest.json (swap models by changing this)
DATA_DIR=data                 # uploaded datasets, results and prediction history
API_KEY=                      # set to require an X-API-Key header on /v1/* (empty = open, dev only)
MAX_UPLOAD_MB=50
MAX_ROWS=200000
MAX_BATCH_RECORDS=5000
RATE_LIMIT_PER_MIN=240        # per API key / client IP, per process. 0 disables.
ALLOW_VERSION_MISMATCH=0      # 1 = only warn if scikit-learn/xgboost differ from training (not recommended)

# ---- frontend ------------------------------------------------------------------------
BACKEND_URL=http://127.0.0.1:5000
# API_KEY above is also sent by the frontend when set.
REQUEST_TIMEOUT=30
UPLOAD_TIMEOUT=300

# ---- assistant (RAG) -----------------------------------------------------------------
# Full list of RAG settings: rag/.env.example. Real environment variables / this file are read by rag/config.py.
LLM_PROVIDER=ollama           # huggingface | ollama | openai | gemini
LLM_MODEL=qwen2.5:3b
# OLLAMA_URL=http://localhost:11434   (inside Docker use http://host.docker.internal:11434)
# OPENAI_API_KEY= / GEMINI_API_KEY=   only for the provider you chose

# ---- PostgreSQL (used by docker compose) ---------------------------------------------------------
# REQUIRED. Letters and digits only (it is placed inside a connection URL). Put the real value in a file named .env
# (never in this example file, and never in git).
POSTGRES_PASSWORD=
# POSTGRES_USER=churn
# POSTGRES_DB=churn

# ---- Surnames (personal data) --------------------------------------------------------------------
# They are stored, but responses hide them unless a request asks (?include_surname=true).
# ALLOW_SURNAME_ACCESS=false makes the server refuse such requests altogether.
# ALLOW_SURNAME_ACCESS=true allows surname access, but the frontend still hides them unless the user explicitly enables it in settings.